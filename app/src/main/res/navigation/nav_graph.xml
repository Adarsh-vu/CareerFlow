<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.arshcreations.careerflow.ui.splash.SplashFragment"
        tools:layout="@layout/fragment_splash" />

    <!-- Auth flow -->
    <navigation
        android:id="@+id/auth_graph"
        app:startDestination="@id/signInFragment">

        <fragment
            android:id="@+id/signInFragment"
            android:name="com.arshcreations.careerflow.ui.auth.SignInFragment"
            tools:layout="@layout/fragment_sign_in">
            <action
                android:id="@+id/action_signInFragment_to_signUpFragment"
                app:destination="@id/signUpFragment" />
            <action
                android:id="@+id/action_signInFragment_to_main_graph"
                app:destination="@id/main_graph"
                app:popUpTo="@id/auth_graph"
                app:popUpToInclusive="true" />
        </fragment>

        <fragment
            android:id="@+id/signUpFragment"
            android:name="com.arshcreations.careerflow.ui.auth.SignUpFragment"
            tools:layout="@layout/fragment_sign_up">
            <action
                android:id="@+id/action_signUpFragment_to_main_graph"
                app:destination="@id/main_graph"
                app:popUpTo="@id/auth_graph"
                app:popUpToInclusive="true" />
        </fragment>
    </navigation>

    <!-- Main app graph -->
    <include
        android:id="@+id/main_graph"
        app:graph="@navigation/main_nav" />
</navigation>

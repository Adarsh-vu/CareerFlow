<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.arshcreations.careerflow.ui.splash.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splashFragment_to_auth_graph"
            app:destination="@id/auth_graph"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_main_graph"
            app:destination="@id/main_nav"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <navigation
        android:id="@+id/auth_graph"
        app:startDestination="@id/signInFragment">
        <fragment
            android:id="@+id/signInFragment"
            android:name="com.arshcreations.careerflow.ui.auth.SignInFragment"
            android:label="SignInFragment"
            tools:layout="@layout/fragment_sign_in">
            <action
                android:id="@+id/action_signInFragment_to_signUpFragment"
                app:destination="@id/signUpFragment" />
            <action
                android:id="@+id/action_signInFragment_to_main_graph"
                app:destination="@id/main_nav"
                app:popUpTo="@id/auth_graph"
                app:popUpToInclusive="true" />
        </fragment>
        <fragment
            android:id="@+id/signUpFragment"
            android:name="com.arshcreations.careerflow.ui.auth.SignUpFragment"
            android:label="SignUpFragment"
            tools:layout="@layout/fragment_sign_up">
            <action
                android:id="@+id/action_signUpFragment_to_main_graph"
                app:destination="@id/main_nav"
                app:popUpTo="@id/auth_graph"
                app:popUpToInclusive="true" />
        </fragment>
    </navigation>

    <fragment
        android:id="@+id/careerPlannerFragment"
        android:name="com.arshcreations.careerflow.ui.planner.CareerPlannerFragment"
        android:label="@string/planner_title"
        tools:layout="@layout/fragment_career_planner" />

    <action
        android:id="@+id/action_homeFragment_to_careerPlannerFragment"
        app:destination="@id/careerPlannerFragment" />

    <!-- Global action to CareerGuide -->
    <action
        android:id="@+id/action_global_to_careerGuideFragment"
        app:destination="@id/careerGuideFragment" />

    <!-- Include main navigation -->
    <include app:graph="@navigation/main_nav" />

</navigation>

<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.arshcreations.careerflow.ui.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_collegesFragment_personalized"
            app:destination="@id/collegesFragment">
            <argument
                android:name="isPersonalizedSearch"
                android:defaultValue="true" />
        </action>
        <action
            android:id="@+id/action_homeFragment_to_aptitudeFragment"
            app:destination="@id/aptitudeFragment" />
        <action
            android:id="@+id/action_homeFragment_to_careerGuideFragment"
            app:destination="@id/careerGuideFragment" />
    </fragment>

    <fragment
        android:id="@+id/collegesFragment"
        android:name="com.arshcreations.careerflow.ui.colleges.CollegesFragment"
        android:label="CollegesFragment"
        tools:layout="@layout/fragment_colleges">
        <action
            android:id="@+id/action_collegesFragment_to_collegeDetailFragment"
            app:destination="@id/collegeDetailFragment" />
        <argument
            android:name="isPersonalizedSearch"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/aptitudeFragment"
        android:name="com.arshcreations.careerflow.ui.aptitude.AptitudeFragment"
        android:label="AptitudeFragment"
        tools:layout="@layout/fragment_aptitude">
        <action
            android:id="@+id/action_aptitudeFragment_to_aptitudeResultsFragment"
            app:destination="@id/aptitudeResultsFragment" />
    </fragment>

    <fragment
        android:id="@+id/aptitudeResultsFragment"
        android:name="com.arshcreations.careerflow.ui.aptitude.AptitudeResultsFragment"
        android:label="fragment_aptitude_results"
        tools:layout="@layout/fragment_aptitude_results">
        <argument
            android:name="analysisResult"
            app:argType="com.arshcreations.careerflow.ui.aptitude.AnalysisResult" />
    </fragment>

    <!-- CareerGuide Fragment - ONLY ONE! -->
    <fragment
        android:id="@+id/careerGuideFragment"
        android:name="com.arshcreations.careerflow.ui.careerguide.CareerGuideFragment"
        android:label="Mentra"
        tools:layout="@layout/fragment_career_guide">
        <action
            android:id="@+id/action_careerGuideFragment_to_collegeDetailFragment"
            app:destination="@id/collegeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.arshcreations.careerflow.ui.profile.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_auth_graph"
            app:destination="@id/auth_graph"
            app:popUpTo="@id/main_nav"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/collegeDetailFragment"
        android:name="com.arshcreations.careerflow.ui.colleges.CollegeDetailFragment"
        android:label="fragment_college_detail"
        tools:layout="@layout/fragment_college_detail">
        <argument
            android:name="college"
            app:argType="com.arshcreations.careerflow.data.models.College" />
    </fragment>

</navigation>

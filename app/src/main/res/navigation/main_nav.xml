<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.arshcreations.careerflow.ui.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_collegesFragment_personalized"
            app:destination="@id/collegesFragment">
            <argument
                android:name="isPersonalizedSearch"
                android:defaultValue="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/collegesFragment"
        android:name="com.arshcreations.careerflow.ui.colleges.CollegesFragment"
        android:label="CollegesFragment"
        tools:layout="@layout/fragment_colleges">
        <action
            android:id="@+id/action_collegesFragment_to_collegeDetailFragment"
            app:destination="@id/collegeDetailFragment" />
        <argument
            android:name="isPersonalizedSearch"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/aptitudeFragment"
        android:name="com.arshcreations.careerflow.ui.aptitude.AptitudeFragment"
        android:label="AptitudeFragment"
        tools:layout="@layout/fragment_aptitude"/>

    <fragment
        android:id="@+id/aiGuideFragment"
        android:name="com.arshcreations.careerflow.ui.aiguide.AiGuideFragment"
        android:label="AiGuideFragment"
        tools:layout="@layout/fragment_ai_guide"/>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.arshcreations.careerflow.ui.profile.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_auth_graph"
            app:destination="@id/auth_graph"
            app:popUpTo="@id/main_nav"
            app:popUpToInclusive="true" />
    </fragment> <fragment
    android:id="@+id/collegeDetailFragment"
    android:name="com.arshcreations.careerflow.ui.colleges.CollegeDetailFragment"
    android:label="fragment_college_detail"
    tools:layout="@layout/fragment_college_detail" >
    <argument
        android:name="college"
        app:argType="com.arshcreations.careerflow.data.models.College" />
</fragment>

</navigation>
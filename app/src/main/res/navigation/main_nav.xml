<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.arshcreations.careerflow.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_collegesFragment"
            app:destination="@id/collegesFragment" />
    </fragment>

    <fragment
        android:id="@+id/collegesFragment"
        android:name="com.arshcreations.careerflow.ui.colleges.CollegesFragment"
        android:label="Colleges"
        tools:layout="@layout/fragment_colleges" />

    <fragment
        android:id="@+id/aptitudeFragment"
        android:name="com.arshcreations.careerflow.ui.aptitude.AptitudeFragment"
        android:label="Aptitude"
        tools:layout="@layout/fragment_aptitude" />

    <fragment
        android:id="@+id/aiGuideFragment"
        android:name="com.arshcreations.careerflow.ui.aiguide.AiGuideFragment"
        android:label="AI Guide"
        tools:layout="@layout/fragment_ai_guide" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.arshcreations.careerflow.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>
